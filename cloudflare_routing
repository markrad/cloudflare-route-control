#!/usr/bin/bash

usage() {
    cat <<EOF
Usage: $(basename "$0") action host service [options]

Arguments:
  action:        The action to perform
                 status-all - returns all active cloudflare routes
                 status - returns the status of a specified route - requires host
                 on - turns on a route - requires host and service
                 off - turns off a route - requires host
  host:          The host name associated with the route as in myapp.example.com
  service:       The service to call on your local network - a reverse proxy for example
  -h, --help     Show this help message

Examples:
  $(basename "$0") status-all
  $(basename "$0") on your.example.com http://nginx:80

Note:
  A file called .cf-env must be in the same directory. It's format is:

  ACCOUNT_ID=<Cloudflare account id>
  TUNNEL_ID=<Cloudflare tunnel id>
  CF_API_TOKEN=<Cloudflare API token>
EOF
}

# Check for help request
case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

# Source the secrets and make sure they are all present
if [[ -f .cf-env ]]; then
    source "$(dirname "${BASH_SOURCE[0]}")/.cf-env"
else
    echo "Error: file .cf-env was not found" >&2
    exit 2
fi 

if [ -z ${ACCOUNT_ID:-} ]; then
    echo "Account ID must be provided in .cf-env (ACCOUNT_ID)" >&2
    exit 2
fi

if [ -z ${TUNNEL_ID:-} ]; then
    echo "Tunnel ID must be provided in .cf-env (TUNNEL_ID)" >&2
    exit 2
fi

if [ -z ${CF_API_TOKEN:-} ]; then
    echo "Cloudflare API token must be provided in .cf-env (CF_API_TOKEN)" >&2
    exit 2
fi

# Error checking
set -euo pipefail

# Grab the script arguments
ACTION=${1:-}
HOST=${2:-}
SVC=${3:-}

# Build the Cloudflare URL and authorization header
URL="https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/cfd_tunnel/$TUNNEL_ID/configurations"
AUTH=(-H "Authorization: Bearer $CF_API_TOKEN")

CFG=$(curl -s "${AUTH[@]}" "$URL" | jq '.result.config')

# Check the action was provided
if [ -z "$ACTION" ]; then
    echo "Error: Missing action" >&2
    exit 2
fi

# status-all?
if [ "$ACTION" = status-all ]; then
    jq -c '[.ingress[] | select(.hostname) | {key: .hostname, value: "on"}] | from_entries' <<<"$CFG"
    exit
fi

# All other commands require a host
if [ -z "$HOST" ]; then
    echo "Error: Host is required for status, on or off" >&2
    exit 2
fi

# status?
if [ "$ACTION" = status ]; then
    jq -r --arg h "$HOST" '
      .ingress
      | map(select(.hostname == $h))[0]
      | if . then "on - \(.service)" else "off" end
    ' <<<"$CFG"
    exit
# on?
elif [ "$ACTION" = on ]; then
    if [ -z "$SVC" ]; then
        echo Error: Action on requires the service to be provided >&2
        exit 2
    fi

    NEW=$(jq --arg h "$HOST" --arg s "$SVC" '
        .ingress |= (
          map(select(.hostname != $h)) as $routes
          | $routes[0:-1]
          + [{hostname: $h, service: $s}]
          + $routes[-1:]
      )
    ' <<<"$CFG")
# off?    
elif [ "$ACTION" = off ]; then
    NEW=$(jq --arg h "$HOST" '
      .ingress |= map(select(.hostname != $h))
    ' <<<"$CFG")
# Bad action
else
    echo "Error: Invalid action ${ACTION} passed" >&2
    exit 2
fi

RESPONSE=$(curl -s -X PUT "${AUTH[@]}" \
  -H "Content-Type: application/json" \
  --data "$(jq -n --argjson c "$NEW" '{config: $c}')" \
  "$URL")

if jq -e '.success == true' <<<"$RESPONSE" >/dev/null; then
    if [ "$ACTION" = on ]; then
        echo "on - $HOST -> $SVC"
    else
        echo "off - $HOST"
    fi
else
    echo "Error: Request failed:" >&2
    jq -r '.errors[]? | "- \(.code): \(.message)"' <<<"$RESPONSE" >&2
    exit 1
fi
